{
  "manifest_version": 3,
  "name": "LCTrack",
  "version": "0.3.0",
  "description": "Daily LeetCode reps with optional Notion capture",
  "minimum_chrome_version": "142",
  "incognito": "not_allowed",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": ["https://leetcode.com/problems/*", "https://api.notion.com/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src https://api.notion.com; object-src 'none'; base-uri 'none'; frame-src 'none'"
  },
  "icons": {
    "16": "icons/square-terminal-16.png",
    "32": "icons/square-terminal-32.png",
    "48": "icons/square-terminal-48.png",
    "128": "icons/square-terminal-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open LCTrack",
    "default_icon": {
      "16": "icons/square-terminal-16.png",
      "32": "icons/square-terminal-32.png",
      "48": "icons/square-terminal-48.png",
      "128": "icons/square-terminal-128.png"
    }
  },
  "commands": {
    "toggle-side-panel": {
      "description": "Toggle LCTrack side panel"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["leetcode-model-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
