# Create an internal Notion integration and share one empty parent page with it.
NOTION_TOKEN=ntn_replace_me
NOTION_PARENT_PAGE_ID=replace_me

# The setup script writes non-secret database IDs here.
NOTION_MANIFEST_PATH=build/notion-manifest.json
# First-run fallback only; dashboard changes persist under ignored build/.
DAILY_NEW_PROBLEM_GOAL=10

# Local bridge settings. Use a long random value.
BRIDGE_TOKEN=replace_with_at_least_24_random_characters
PORT=8787
